\newcommand{\imgfr}[2]{
\begin{frame}{#2}
\imgfull{#1}{#2}
\end{frame}
}

\newcommand{\itfr}[3]{
\begin{frame}
\frametitle{#1}
\begin{columns}
\begin{column}{0.5\textwidth} 
\imgfull{#2}{#1}
\end{column}
\begin{column}{0.5\textwidth}
   #3
\end{column}
\end{columns}
\end{frame}
}


\newcommand{\itemfr}[2]{
\setsepchar{;}
\begin{frame}{#1}
\readlist*\Z{#2}
\begin{itemize}
   \foreachitem\word\in\Z{\item  \word\par}
\end{itemize}
\end{frame}
}

