\newcommand{\actividad}[1]{\subsection*{\faEdit Actividad: #1}}

\newcommand{\caja}[2]{
\begin{tcolorbox}
\textbf{#1}
\tcblower
#2
\end{tcolorbox}}

\newcommand{\info}[2]{\caja{\faInfoCircle \hspace{1pt} #1:}{#2}}

\newcommand{\news}[2]{\caja{\faNewspaperO \hspace{1pt} #1:}{\begin{multicols}{2}#2
    \end{multicols}}}
\newcommand{\ejemplo}[2]{\caja{\faHandORight \hspace{1pt} #1:}{#2}}

\newcommand{\web}[2]{\caja{\faExternalLink \hspace{1.5pt} #2}{
\begin{tabular}{c | c}
\qrcode{#1} & \footnotesize \url{#1}
\end{tabular}}}

\newcommand{\video}[2]{\caja{\faFilm \hspace{1.5pt} #2}{
\begin{tabular}{c | c}
\qrcode{#1} & \url{#1}
\end{tabular}}}
\newsavebox{\picbox}

\newcommand{\cutpic}[3]{
  \savebox{\picbox}{\includegraphics[interpolate,width=#2]{#3}}
  \tikz\node [draw, rounded corners=#1, line width=4pt,
    color=white, minimum width=\wd\picbox,
    minimum height=\ht\picbox, path picture={
      \node at (path picture bounding box.center) {
        \usebox{\picbox}};
    }] {};

}

\newcommand{\img}[2]{
\begin{figure}[ht]
    \centering
    \cutpic{0.5cm}{.5\textwidth}{#1}
    \caption{#2}
\end{figure}
}
%nuevo código agregado
\newcommand{\imgfull}[2]{
\begin{figure}[ht]
    \centering
    \cutpic{0.5cm}{1\textwidth}{#1}
    \caption{#2}
\end{figure}
}


